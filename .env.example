# --- Required ---

# Public base URL of this proxy (used as issuer and to build endpoint URLs in well-known docs).
# Must be http or https. Trailing slashes are stripped automatically.
MCP_BASE_URL=http://localhost:3000

# Issuer URL of the upstream IdP (e.g. Keycloak: https://sso.company.com/auth/realms/external, Auth0: https://tenant.auth0.com, Okta: https://org.okta.com/oauth2/default).
# Must be http or https. Trailing slashes are stripped automatically.
# Discovery is attempted via /.well-known/openid-configuration then /.well-known/oauth-authorization-server (RFC 8414).
MCP_UPSTREAM_SSO_URL=https://sso.company.com/auth/realms/external

# OAuth client_id returned by the DCR endpoint (POST /register); setting this enables the DCR proxy.
# Must be pre-registered at the upstream IdP. If omitted, the DCR endpoint is not mounted
# and the upstream IdP's registration endpoint is announced directly if present.
MCP_PROXY_DCR_CLIENT_ID=mcp-client

# --- Optional (defaults shown) ---

# Port the proxy listens on
MCP_PORT=3000

# Comma-separated list of scopes to advertise in the well-known scopes_supported field; if empty, scopes_supported is omitted
MCP_WELL_KNOWN_SCOPES_SUPPORTED=

# Comma-separated scopes to strip from the authorization request before forwarding to upstream.
# Setting this (or MCP_PROXY_AUTH_SCOPES_PRESERVED, or CIMD config) auto-enables the /authorize proxy;
# when none of these are configured, the upstream IdP's authorization endpoint is used directly.
MCP_PROXY_AUTH_SCOPES_REMOVED=offline_access

# Comma-separated scopes to allow in the authorization request; all others are stripped.
# Takes precedence over MCP_PROXY_AUTH_SCOPES_REMOVED if both are set.
MCP_PROXY_AUTH_SCOPES_PRESERVED=

# How often (in minutes) to re-fetch the upstream well-known document; on failure the previous document is kept
MCP_WELL_KNOWN_REFRESH_MINUTES=60

# Enable Prometheus metrics endpoint (GET /metrics) and request instrumentation
# MCP_METRICS_ENABLED=true

# Enable debug-level structured logging
MCP_DEBUG=false

# Graceful shutdown timeout in seconds; if in-flight requests are not drained within
# this period after SIGTERM/SIGINT, the process exits with code 1
# MCP_SHUTDOWN_TIMEOUT_SECONDS=30

# --- RFC 9207 iss Interception ---
# These variables control the authorization response interception that ensures MCP clients
# receive a correct `iss` parameter matching the adapter's issuer. Setting MCP_PROXY_AUTH_STATE_SECRET
# alone also activates the /authorize proxy (no scope filtering needed).
# Required when the /authorize proxy is active for ANY reason (scope filtering, CIMD, or standalone iss mode).

# Hex-encoded HMAC secret for signing the state blob (min 32 bytes / 64 hex chars).
# Generate with: openssl rand -hex 32
# MUST be identical across all pods in multi-replica deployments.
MCP_PROXY_AUTH_STATE_SECRET=

# Previous HMAC secret for zero-downtime rotation (optional, same format as above).
# Set to the old key during rotation; remove after MCP_PROXY_AUTH_STATE_TTL_MINUTES has elapsed.
# MCP_PROXY_AUTH_STATE_SECRET_PREVIOUS=

# How long (in minutes) the signed state blob remains valid. Must cover the full user interaction
# at the upstream IdP (login, registration, email verification, MFA, consent). Default: 30
# MCP_PROXY_AUTH_STATE_TTL_MINUTES=30

# Comma-separated list of allowed redirect URI patterns for MCP clients.
# Trailing * means prefix match; no * means exact match.
# Required when /authorize proxy is active (unless CIMD-only).
# Example covering known MCP clients:
# MCP_PROXY_AUTH_ALLOWED_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*,cursor://anysphere.cursor-mcp/*,https://insiders.vscode.dev/*,https://vscode.dev/*,warp://mcp/*,vscode://saoudrizwan.claude-dev/*
MCP_PROXY_AUTH_ALLOWED_REDIRECT_URIS=

# --- CIMD Adapter (EXPERIMENTAL) ---
# Client ID Metadata Document support per draft-ietf-oauth-client-id-metadata-document-01.
# CIMD auto-enables when MCP_PROXY_CIMD_MAP is non-empty or MCP_PROXY_CIMD_DEFAULT_CLIENT_ID is set. auto-enables the /authorize proxy.

# JSON object mapping CIMD URLs to upstream IdP client_ids. Multiple CIMD URLs can map to the same upstream client.
# Format: {"<cimd_url>": "<upstream_client_id>", ...}
# MCP_PROXY_CIMD_MAP={"https://cursor.com/.well-known/oauth-client.json":"cursor-sso-client","https://claude.ai/.well-known/oauth-client.json":"claude-sso-client"}

# Fallback upstream client_id for CIMD URLs not in the map. If unset, unknown CIMD URLs are rejected (strict allowlist).
# MCP_PROXY_CIMD_DEFAULT_CLIENT_ID=

# Cache TTL (in minutes) for validated CIMD metadata documents
# MCP_PROXY_CIMD_CACHE_MINUTES=30

# --- RFC 8707 Resource Parameter Validation ---
# Optional enforcement of the RFC 8707 resource parameter in /authorize and /token requests.
# When disabled (default), the resource parameter is logged and format-validated if present,
# but requests without it are allowed through.

# Require the resource parameter in /authorize and /token requests (MCP spec requirement).
# Default: false (to avoid breaking clients that don't yet send it).
# MCP_PROXY_AUTH_REQUIRE_RESOURCE=false

# Comma-separated allowed resource URI patterns.
# Trailing * = prefix match, no * = exact match.
# If unset, any valid resource URI is accepted (format validation only).
# Example: MCP_PROXY_AUTH_ALLOWED_RESOURCES=https://mcp.example.com/*,https://api.example.com/mcp
# MCP_PROXY_AUTH_ALLOWED_RESOURCES=
