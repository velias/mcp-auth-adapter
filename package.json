{
  "name": "mcp-auth-adapter",
  "version": "2.1.0",
  "description": "OAuth/OIDC authentication adapter for MCP clients",
  "main": "dist/index.js",
  "bin": {
    "mcp-auth-adapter": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "changelog": "bash scripts/generate-changelog.sh",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "oauth",
    "oidc",
    "auth",
    "adapter",
    "proxy",
    "keycloak",
    "authorization",
    "identity-provider",
    "idp",
    "well-known",
    "openid-configuration",
    "oauth-authorization-server",
    "dcr",
    "cimd",
    "prometheus",
    "metrics"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/velias/mcp-auth-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/velias/mcp-auth-adapter/issues"
  },
  "homepage": "https://github.com/velias/mcp-auth-adapter#readme",
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^10.2.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.3",
    "typescript-eslint": "^8.59.0"
  }
}
